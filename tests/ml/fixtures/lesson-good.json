 "steps": [
  {
   "id": "ml-l08-s1",
   "title": {
    "en": "Which column says more?",
    "ro": "Care coloană spune mai mult?"
   },
   "blocks": [
    {
     "type": "mcq",
     "id": "ml-l08-pre",
     "question": {
      "en": "The table shows 4 days. What fraction of the days have play?",
      "ro": "Tabelul arată 4 zile. Ce fracțiune din zile sunt cu joc?"
     },
     "table": {
      "columns": [
       "Vreme",
       "Joc"
      ],
      "rows": [
       [
        "Soare",
        "Nu"
       ],
       [
        "Soare",
        "Da"
       ],
       [
        "Ploaie",
        "Da"
       ],
       [
        "Ploaie",
        "Da"
       ]
      ],
      "caption": {
       "en": "Four days",
       "ro": "Patru zile"
      }
     },
     "check": {
      "formula": "3/4"
     },
     "options": [
      {
       "text": {
        "en": "3/4",
        "ro": "3/4"
       },
       "correct": true,
       "explain": {
        "en": "Three of the 4 days have play: 3/4.",
        "ro": "Trei din cele 4 zile au joc: 3/4."
       }
      },
      {
       "text": {
        "en": "1/2",
        "ro": "1/2"
       },
       "correct": false,
       "explain": {
        "en": "1/2 counts only the sunny days.",
        "ro": "1/2 numără doar zilele cu soare."
       },
       "misconception": "caz-particular"
      },
      {
       "text": {
        "en": "1/4",
        "ro": "1/4"
       },
       "correct": false,
       "explain": {
        "en": "1/4 is the share of days without play.",
        "ro": "1/4 este partea zilelor fără joc."
       },
       "misconception": "p-a-b-p-b-a"
      }
     ]
    }
   ]
  },
  {
   "id": "ml-l08-s2",
   "title": {
    "en": "Two kinds of entropy",
    "ro": "Două feluri de entropie"
   },
   "blocks": [
    {
     "type": "definition",
     "term": {
      "en": "Specific conditional entropy",
      "ro": "Entropia condiționată specifică"
     },
     "content": {
      "en": "$H(Y|X=x)$ is the entropy of Y among the rows with X = x.",
      "ro": "$H(Y|X=x)$ este entropia lui Y între rândurile cu X = x."
     }
    },
    {
     "type": "definition",
     "term": {
      "en": "Average conditional entropy",
      "ro": "Entropie condiționată medie"
     },
     "content": {
      "en": "$H(Y|X)=\\sum_x P(x)H(Y|X=x)$.",
      "ro": "$H(Y|X)=\\sum_x P(x)H(Y|X=x)$."
     }
    }
   ]
  },
  {
   "id": "ml-l08-s3",
   "title": {
    "en": "Which one is the weighted average?",
    "ro": "Care este media ponderată?"
   },
   "blocks": [
    {
     "type": "mcq",
     "id": "ml-l08-q1",
     "question": {
      "en": "Which quantity weights each branch by its size?",
      "ro": "Care mărime ponderează fiecare ramură cu mărimea ei?"
     },
     "options": [
      {
       "text": {
        "en": "H(Y|X=x)",
        "ro": "H(Y|X=x)"
       },
       "correct": false,
       "explain": {
        "en": "That is one branch only.",
        "ro": "Aceasta este doar o ramură."
       },
       "misconception": "unweighted-branch-comparison"
      },
      {
       "text": {
        "en": "H(Y|X)",
        "ro": "H(Y|X)"
       },
       "correct": true,
       "explain": {
        "en": "It adds the branches with weights P(x).",
        "ro": "Adună ramurile cu ponderile P(x)."
       }
      },
      {
       "text": {
        "en": "H(Y)",
        "ro": "H(Y)"
       },
       "correct": false,
       "explain": {
        "en": "That ignores X.",
        "ro": "Aceasta ignoră X."
       },
       "misconception": "h-y-given-x-is-a-variable"
      }
     ]
    }
   ]
  },
  {
   "id": "ml-l08-s4",
   "title": {
    "en": "Can conditioning raise entropy?",
    "ro": "Poate condiționarea să crească entropia?"
   },
   "blocks": [
    {
     "type": "mcq",
     "id": "ml-l08-q2",
     "question": {
      "en": "On average, how does H(Y|X) compare with H(Y)?",
      "ro": "În medie, cum se compară H(Y|X) cu H(Y)?"
     },
     "options": [
      {
       "text": {
        "en": "It is larger",
        "ro": "Este mai mare"
       },
       "correct": false,
       "explain": {
        "en": "Knowing X cannot add doubt on average.",
        "ro": "Să știi X nu poate adăuga îndoială în medie."
       },
       "misconception": "ig-negative-or-above-h"
      },
      {
       "text": {
        "en": "It is equal",
        "ro": "Este egală"
       },
       "correct": false,
       "explain": {
        "en": "Equality holds only for independent variables.",
        "ro": "Egalitatea apare doar la variabile independente."
       },
       "misconception": "min-ig-vs-max-h"
      },
      {
       "text": {
        "en": "It is not larger",
        "ro": "Nu este mai mare"
       },
       "correct": true,
       "explain": {
        "en": "Conditioning never raises the average entropy.",
        "ro": "Condiționarea nu crește niciodată entropia medie."
       }
      }
     ]
    }
   ]
  },
